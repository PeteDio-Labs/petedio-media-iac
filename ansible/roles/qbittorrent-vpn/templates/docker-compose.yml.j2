# Managed by Ansible — DO NOT EDIT
# Source: ansible/roles/qbittorrent-vpn/templates/docker-compose.yml.j2 (petedio-media-iac)
#
# Three-service stack on LXC 110:
#   1. gluetun       — ProtonVPN WireGuard tunnel + kill switch + NAT-PMP port forward
#   2. qbittorrent   — LinuxServer.io image with VueTorrent UI mod, network=service:gluetun
#   3. port-sync     — alpine sidecar, syncs gluetun's forwarded port → qBit listen port
#
# The header on the previous copy of this file credited
# `infrastructure/ansible/templates/...` in the retired homelab-infra repo and called
# this "LXC 120". Neither was true: that repo is gone and the container is 110, so the
# file was in practice unmanaged. This template is now the source of truth.
#
# Secrets (${PROTON_*}, ${QBIT_WEBUI_PASSWORD}) still come from /opt/qbittorrent-vpn/.env
# on the host, which is NOT rendered here and NOT committed — compose reads it at runtime.

services:
  gluetun:
    image: {{ qbit_image_gluetun }}
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    ports:
      # qBit WebUI is published via gluetun (qBit shares gluetun's net namespace)
      - "8080:8080"
      # Gluetun control API — bound to loopback only so the sidecar can hit it
      # but it's not reachable from the LAN
      - "127.0.0.1:8000:8000"
    environment:
      VPN_SERVICE_PROVIDER: protonvpn
      VPN_TYPE: wireguard
      WIREGUARD_PRIVATE_KEY: ${PROTON_WG_PRIVATE_KEY}
      WIREGUARD_ADDRESSES: ${PROTON_WG_ADDRESSES}
      SERVER_COUNTRIES: ${PROTON_SERVER_COUNTRIES}
      # NAT-PMP port forwarding (Plus tier required)
      VPN_PORT_FORWARDING: "on"
      VPN_PORT_FORWARDING_PROVIDER: protonvpn
      # Allow LAN access to qBit WebUI through gluetun's firewall
      FIREWALL_OUTBOUND_SUBNETS: 192.168.50.0/24
      # Health check — restart tunnel if it goes down
      HEALTH_VPN_DURATION_INITIAL: 30s
      # Control API on :8000 (loopback published only)
      HTTP_CONTROL_SERVER_ADDRESS: ":8000"
      TZ: America/Los_Angeles
    volumes:
      - /opt/qbittorrent-vpn/gluetun:/gluetun
    restart: unless-stopped
    # Healthcheck is provided by gluetun's image HEALTHCHECK directive (it
    # checks the internal /gluetun-entrypoint healthcheck on :9999 which
    # validates the VPN tunnel itself). Don't override it here — the control
    # API on :8000 requires auth and would 401 a custom wget healthcheck.

  qbittorrent:
    image: {{ qbit_image_qbittorrent }}
    container_name: qbittorrent
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: America/Los_Angeles
      WEBUI_PORT: "8080"
      # Drop in VueTorrent (modern dark UI) via the official LSIO mod
      DOCKER_MODS: ghcr.io/vuetorrent/vuetorrent-lsio-mod:latest
    volumes:
      - /opt/qbittorrent-vpn/qbittorrent/config:/config
      - /downloads:/downloads
      - /media:/media
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS -m 3 -o /dev/null http://localhost:8080/api/v2/app/version || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s

  port-sync:
    image: {{ qbit_image_portsync }}
    container_name: qbit-port-sync
    network_mode: "service:gluetun"
    depends_on:
      qbittorrent:
        condition: service_started
    environment:
      QBIT_USER: admin
      QBIT_PASSWORD: ${QBIT_WEBUI_PASSWORD}
      SYNC_INTERVAL: "300"
    volumes:
      - /opt/qbittorrent-vpn/port-sync/port-sync.sh:/port-sync.sh:ro
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        apk add --no-cache curl jq >/dev/null
        exec /bin/sh /port-sync.sh
    restart: unless-stopped
